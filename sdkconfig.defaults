CONFIG_IDF_TARGET="esp32s3"

# --- Flash (SG SDK: src/platforms/F1/configs/sdkconfig.board) ---
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_VDDSDIO_BOOST_1_9V=y

# --- CPU ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# --- PSRAM: QUAD (SG SDK: src/platforms/F1/configs/sdkconfig.spiram_sx) ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# --- Networking (used from Stage 1) ---
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_PAP_SUPPORT=y
CONFIG_LWIP_PPP_CHAP_SUPPORT=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# PPP keepalive between ESP32 and modem (link-local, not sent over the air): detects a hung
# modem/PPP link, especially in plain-PPP mode where AT polling is impossible.
CONFIG_LWIP_ENABLE_LCP_ECHO=y
CONFIG_LWIP_LCP_ECHOINTERVAL=10
CONFIG_LWIP_LCP_MAXECHOFAILS=3

# --- esp_modem (SG SDK: src/platforms/F1/configs/sdkconfig.espmodem) ---
CONFIG_ESP_MODEM_CMUX_DEFRAGMENT_PAYLOAD=y
CONFIG_ESP_MODEM_USE_INFLATABLE_BUFFER_IF_NEEDED=y
CONFIG_ESP_MODEM_CMUX_DELAY_AFTER_DLCI_SETUP=100
CONFIG_ESP_MODEM_CMUX_USE_SHORT_PAYLOADS_ONLY=n
CONFIG_ESP_MODEM_URC_HANDLER=y
CONFIG_ESP_MODEM_PPP_ESCAPE_BEFORE_EXIT=n

# --- Diagnostics ---
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- App stages ---
CONFIG_APP_ENABLE_LTE=y
CONFIG_APP_LTE_ATTACH_TIMEOUT_S=180
CONFIG_APP_LTE_MODE_CMUX=y

# --- Stage 3 camera (only takes effect when CONFIG_APP_ENABLE_CAMERA=y; unused code is GC'd otherwise) ---
# From espressif/usb_host_uvc examples/basic_uvc_stream/sdkconfig.defaults:
#  UVC configuration descriptors are often > 256 B (default), which breaks enumeration.
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=4096
#  Give the DWC FIFO RAM to IN endpoints (video is IN-only).
CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y
# espressif/esp_jpeg: use the component's TJpgDec instead of the ROM copy, because UVC MJPEG frames
# usually omit the Huffman tables (DHT) and only the non-ROM build can supply defaults (README.md).
CONFIG_JD_USE_ROM=n
CONFIG_JD_DEFAULT_HUFFMAN=y
