# Settings for the SG Wireless F1 Starter Kit (values from SG Wireless's F1 SDK).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000

# Flash: 16 MB, DIO @ 40 MHz
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_VDDSDIO_BOOST_1_9V=y

# PSRAM: 8 MB, quad SPI @ 80 MHz (holds camera frames and the AI model's working memory)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# LTE: PPP over the modem, CMUX mode in esp_modem
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_PAP_SUPPORT=y
CONFIG_LWIP_PPP_CHAP_SUPPORT=y
CONFIG_LWIP_ENABLE_LCP_ECHO=y
CONFIG_LWIP_LCP_ECHOINTERVAL=10
CONFIG_LWIP_LCP_MAXECHOFAILS=3
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_ESP_MODEM_CMUX_DEFRAGMENT_PAYLOAD=y
CONFIG_ESP_MODEM_USE_INFLATABLE_BUFFER_IF_NEEDED=y
CONFIG_ESP_MODEM_CMUX_DELAY_AFTER_DLCI_SETUP=100
CONFIG_ESP_MODEM_CMUX_USE_SHORT_PAYLOADS_ONLY=n
CONFIG_ESP_MODEM_PPP_ESCAPE_BEFORE_EXIT=n

# USB webcam: webcam descriptors are bigger than the 256 B default
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=4096
# JPEG: webcams often leave out the Huffman tables, so use the decoder that has defaults built in
CONFIG_JD_USE_ROM=n
CONFIG_JD_DEFAULT_HUFFMAN=y
