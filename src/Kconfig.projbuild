menu "F1 facecam application"

config APP_ENABLE_LTE
    bool "Enable LTE-M (Stage 1)"
    default y

choice APP_LTE_MODE
    prompt "Modem link mode"
    default APP_LTE_MODE_CMUX
    depends on APP_ENABLE_LTE
    help
        CMUX (what the SG SDK uses) multiplexes AT commands and PPP data on one UART, so
        signal/registration can be monitored while online. Plain PPP is the fallback that
        was verified first on hardware; AT commands are unavailable while it is up.

config APP_LTE_MODE_CMUX
    bool "CMUX (AT + PPP simultaneously)"

config APP_LTE_MODE_PPP
    bool "Plain PPP (no AT while online)"

endchoice

config APP_LTE_HEALTH_PERIOD_S
    int "CMUX health-check period (CSQ + CEREG), seconds"
    default 30
    range 5 3600
    depends on APP_LTE_MODE_CMUX

config APP_LTE_APN
    string "Primary APN"
    default "iot.1nce.net"
    depends on APP_ENABLE_LTE
    help
        Verified on hardware 2026-11-10: kit SIM attaches with iot.1nce.net (Platform 1.0); sensor.net never registered.

config APP_LTE_APN_FALLBACK
    string "Fallback APN (empty = none)"
    default "sensor.net"
    depends on APP_ENABLE_LTE

config APP_LTE_ATTACH_TIMEOUT_S
    int "Seconds to wait for network registration per APN"
    default 180
    depends on APP_ENABLE_LTE

config APP_PUBLISH_URL
    string "HTTP endpoint for JSON events (keep in sdkconfig.defaults.local)"
    default ""
    depends on APP_ENABLE_LTE

config APP_PUBLISH_PERIOD_S
    int "Boot/heartbeat event period (seconds)"
    default 60
    depends on APP_ENABLE_LTE

config APP_ENABLE_INFERENCE
    bool "Enable Edge Impulse inference (Stage 2)"
    default n

config APP_ENABLE_CAMERA
    bool "Enable USB UVC camera (Stage 3)"
    default n

config APP_HEAP_LOG_PERIOD_S
    int "Heap telemetry period (seconds)"
    default 10

endmenu
